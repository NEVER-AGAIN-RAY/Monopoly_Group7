<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="app-root"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.monopoly.fx.MainController">

    <BorderPane fx:id="gamePane" visible="false" managed="false" styleClass="game-screen">
        <top>
            <VBox spacing="8.0" styleClass="top-wrap">
                <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="top-hud">
                    <VBox spacing="1.0">
                        <Label text="MONOPOLY DEAL" styleClass="hud-title"/>
                        <Label fx:id="connectionLabel" text="offline" styleClass="hud-kicker"/>
                    </VBox>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="tableStatusLabel" text="牌桌就绪" styleClass="table-status"/>
                        <Label fx:id="eventLineLabel" text="等待游戏状态..." wrapText="true" styleClass="event-line"/>
                    </VBox>
                    <HBox spacing="8.0" alignment="CENTER" styleClass="stat-strip">
                        <Label fx:id="roundLabel" text="第 1 轮" styleClass="hud-stat"/>
                        <Label fx:id="phaseLabel" text="阶段 -" styleClass="hud-stat"/>
                        <Label fx:id="actionCountLabel" text="已出 0/3" styleClass="hud-stat"/>
                        <Label fx:id="drawPileLabel" text="抽牌 0" styleClass="hud-stat"/>
                        <Label fx:id="discardPileLabel" text="弃牌 0" styleClass="hud-stat"/>
                    </HBox>
                    <Button fx:id="backSetupButton" text="回设置" onAction="#onBackToSetup" mnemonicParsing="false"
                            styleClass="btn-secondary"/>
                    <Button fx:id="disconnectButton" text="断开" onAction="#onDisconnect" mnemonicParsing="false"
                            styleClass="btn-disconnect"/>
                </HBox>
                <Label fx:id="gameErrorLabel" visible="false" managed="false" wrapText="true" styleClass="inline-error"/>
            </VBox>
        </top>

        <center>
            <VBox spacing="10.0" styleClass="table-layout">
                <ScrollPane fx:id="opponentsScroll" fitToHeight="true" fitToWidth="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" prefHeight="224.0"
                            styleClass="opponents-scroll">
                    <HBox fx:id="opponentsBox" spacing="12.0" alignment="CENTER_LEFT" styleClass="opponents-row">
                        <padding>
                            <Insets bottom="8.0" left="6.0" right="6.0" top="6.0"/>
                        </padding>
                    </HBox>
                </ScrollPane>

                <VBox spacing="10.0" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="center-table">
                    <VBox spacing="6.0" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="center-play-zone">
                        <VBox fx:id="centerNoticeBox" spacing="4.0" alignment="CENTER"
                              visible="false" managed="false" styleClass="center-notice">
                            <Label fx:id="centerTitleLabel" text="牌桌就绪" styleClass="center-title"/>
                            <Label fx:id="centerSubtitleLabel" text="开始游戏后，这里会显示当前回合和响应窗口。"
                                   wrapText="true" styleClass="center-subtitle"/>
                        </VBox>
                        <FlowPane fx:id="playedCardsPane" hgap="8.0" vgap="8.0" alignment="CENTER"
                                  styleClass="played-cards"/>
                        <Label fx:id="drawPileNameLabel" text="抽牌堆" visible="false" managed="false"/>
                        <Label fx:id="discardPileNameLabel" text="弃牌堆" visible="false" managed="false"/>
                    </VBox>

                    <VBox fx:id="responseBox" spacing="8.0" visible="false" managed="false"
                          maxWidth="780.0" styleClass="response-panel">
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label fx:id="responseTitleLabel" wrapText="true" HBox.hgrow="ALWAYS"
                                   styleClass="response-title"/>
                            <Label fx:id="responseCountdownLabel" styleClass="response-countdown"/>
                        </HBox>
                        <Label fx:id="responseContextLabel" wrapText="true" styleClass="response-context"/>
                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <Button fx:id="responseJsnButton" text="Just Say No" onAction="#onPlayJustSayNo"
                                    mnemonicParsing="false" styleClass="btn-jsn"/>
                            <Button fx:id="responsePassButton" text="放弃响应" onAction="#onResponsePass"
                                    mnemonicParsing="false" styleClass="btn-quiet"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="rentPaymentBox" spacing="8.0" visible="false" managed="false"
                          maxWidth="780.0" styleClass="rent-payment-panel">
                        <Label fx:id="rentPaymentHint" wrapText="true" styleClass="rent-title"/>
                        <Label fx:id="rentPaymentSumLabel" wrapText="true" styleClass="rent-sum"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    prefHeight="110.0" styleClass="payment-scroll">
                            <FlowPane fx:id="rentPaymentPickPane" hgap="8.0" vgap="8.0" styleClass="payment-picks"/>
                        </ScrollPane>
                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <Button fx:id="rentPaymentGreedyButton" text="自动选牌" onAction="#onRentPaymentGreedy"
                                    mnemonicParsing="false" styleClass="btn-auto"/>
                            <Button fx:id="rentPaymentSubmitButton" text="确认支付" onAction="#onRentPaymentSubmit"
                                    mnemonicParsing="false" styleClass="btn-confirm"/>
                            <Button fx:id="rentPaymentClearButton" text="清空" onAction="#onRentPaymentClear"
                                    mnemonicParsing="false" styleClass="btn-quiet"/>
                        </HBox>
                    </VBox>
                </VBox>

                <HBox fx:id="lowerTableBox" spacing="14.0" alignment="BOTTOM_CENTER" styleClass="lower-table">
                    <VBox spacing="8.0" prefWidth="460.0" minWidth="360.0" styleClass="side-board">
                        <Label fx:id="myBoardTitleLabel" text="我的置牌区" styleClass="lane-title"/>
                        <ScrollPane fx:id="myBoardScroll" fitToWidth="true" hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="board-scroll">
                            <VBox fx:id="myBoardBox" spacing="8.0" styleClass="board-slot"/>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="hand-panel">
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label fx:id="handTitleLabel" text="手牌" styleClass="section-title"/>
                            <Label fx:id="handHintLabel" text="双击会按默认动作快速出牌。" styleClass="hand-hint"/>
                        </HBox>
                        <ScrollPane fx:id="handScroll" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                                    prefHeight="212.0" styleClass="hand-scroll">
                            <HBox fx:id="handStrip" spacing="-48.0" alignment="BOTTOM_CENTER" styleClass="hand-strip">
                                <padding>
                                    <Insets bottom="16.0" left="58.0" right="58.0" top="18.0"/>
                                </padding>
                            </HBox>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="6.0" prefWidth="236.0" minWidth="210.0" styleClass="action-pad">
                        <Label fx:id="actionPadTitleLabel" text="操作区" styleClass="action-pad-title"/>
                        <Label fx:id="selectedCardLabel" text="先点选一张手牌" wrapText="true"
                               styleClass="selected-card-label"/>
                        <StackPane fx:id="selectedPreviewPane" visible="false" managed="false"
                                   minHeight="0.0" styleClass="selected-preview-pane"/>
                        <Button fx:id="drawButton" text="摸 2 张牌" maxWidth="Infinity" onAction="#onDraw"
                                mnemonicParsing="false" styleClass="btn-draw"/>
                        <Button fx:id="endTurnButton" text="结束回合" maxWidth="Infinity" onAction="#onEndTurn"
                                mnemonicParsing="false" styleClass="btn-end-turn"/>
                        <Region minHeight="2.0"/>
                        <Button fx:id="depositButton" text="存入银行" maxWidth="Infinity" onAction="#onDeposit"
                                mnemonicParsing="false" styleClass="btn-deposit"/>
                        <Button fx:id="deployButton" text="部署房产" maxWidth="Infinity" onAction="#onDeploy"
                                mnemonicParsing="false" styleClass="btn-deploy"/>
                        <Button fx:id="actionButton" text="打出行动牌" maxWidth="Infinity" onAction="#onAction"
                                mnemonicParsing="false" styleClass="btn-action"/>
                        <Button fx:id="discardButton" text="弃牌" maxWidth="Infinity" onAction="#onDiscard"
                                mnemonicParsing="false" styleClass="btn-discard"/>
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <ScrollPane fx:id="startPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="start-screen">
        <VBox spacing="16.0" alignment="TOP_CENTER" maxWidth="1180.0" styleClass="start-shell">
            <HBox spacing="18.0" alignment="CENTER_LEFT" styleClass="brand-lockup">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="brandKickerLabel" text="JavaFX 牌桌" styleClass="brand-kicker"/>
                    <Label fx:id="appTitleLabel" text="Monopoly Deal" styleClass="brand-title"/>
                    <Label fx:id="appSubtitleLabel" text="连接 Java WebSocket 后端，体验与 Web 端一致的牌桌。"
                           wrapText="true" styleClass="brand-subtitle"/>
                </VBox>
                <VBox spacing="8.0" styleClass="connect-card">
                    <GridPane hgap="8.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="58.0"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="260.0"/>
                        </columnConstraints>
                        <Label fx:id="serverLabel" text="服务器" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="setup-label"/>
                        <TextField fx:id="wsUrlField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label fx:id="languageLabel" text="语言" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               styleClass="setup-label"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <ComboBox fx:id="languageCombo" prefWidth="124.0"/>
                            <Button fx:id="connectButton" text="连接" onAction="#onConnect" mnemonicParsing="false"
                                    styleClass="btn-secondary"/>
                            <Button fx:id="topRefreshRoomsButton" text="刷新房间" onAction="#onRefreshRooms" mnemonicParsing="false"
                                    styleClass="btn-secondary"/>
                        </HBox>
                    </GridPane>
                    <Label fx:id="statusLabel" text="未连接" styleClass="connection-status"/>
                </VBox>
            </HBox>

            <GridPane hgap="0.0" vgap="0.0" styleClass="start-info">
                <columnConstraints>
                    <ColumnConstraints minWidth="190.0" prefWidth="210.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="8.0" styleClass="info-tabs" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Button fx:id="infoIntroButton" text="游戏介绍" onAction="#onInfoIntro" mnemonicParsing="false"
                            styleClass="info-tab"/>
                    <Button fx:id="infoRulesButton" text="规则说明" onAction="#onInfoRules" mnemonicParsing="false"
                            styleClass="info-tab"/>
                    <Button fx:id="infoGuideButton" text="联机说明" onAction="#onInfoGuide" mnemonicParsing="false"
                            styleClass="info-tab"/>
                </VBox>
                <VBox spacing="7.0" styleClass="info-copy" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="infoTitleLabel" text="这是什么" styleClass="info-title"/>
                    <Label fx:id="infoLine1Label" wrapText="true" styleClass="info-line"/>
                    <Label fx:id="infoLine2Label" wrapText="true" styleClass="info-line"/>
                    <Label fx:id="infoLine3Label" wrapText="true" styleClass="info-line"/>
                </VBox>
            </GridPane>

            <GridPane hgap="14.0" vgap="12.0" styleClass="setup-panel">
                <columnConstraints>
                    <ColumnConstraints percentWidth="18.0"/>
                    <ColumnConstraints percentWidth="14.0"/>
                    <ColumnConstraints percentWidth="18.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label fx:id="gameModeLabel" text="模式" styleClass="setup-label"/>
                    <ComboBox fx:id="gameModeCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="playerCountLabel" text="人数" styleClass="setup-label"/>
                    <Spinner fx:id="playerCountSpinner" editable="false" maxWidth="Infinity"/>
                </VBox>
                <VBox fx:id="aiDifficultyBox" spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label fx:id="aiDifficultyLabel" text="AI 难度" styleClass="setup-label"/>
                    <ComboBox fx:id="aiDifficultyCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label fx:id="playerIdLabel" text="玩家 ID" styleClass="setup-label"/>
                    <TextField fx:id="playerIdField"/>
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="4" GridPane.rowIndex="0">
                    <Label fx:id="sessionIdLabel" text="会话" styleClass="setup-label"/>
                    <TextField fx:id="sessionIdField"/>
                </VBox>
                <HBox fx:id="customLineupBox" spacing="8.0" alignment="CENTER_LEFT" visible="false" managed="false"
                      GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="1">
                    <Label fx:id="customLineupLabel" text="自定义席位" styleClass="setup-label"/>
                    <ComboBox fx:id="customLineupCombo" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="modeHintLabel" wrapText="true" styleClass="setup-hint"
                       GridPane.columnIndex="3" GridPane.columnSpan="2" GridPane.rowIndex="1"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.columnSpan="5"
                      GridPane.rowIndex="2">
                    <Button fx:id="startGameButton" text="开始游戏" onAction="#onStartGame" mnemonicParsing="false"
                            styleClass="btn-start-game"/>
                    <CheckBox fx:id="randomizeFirstCheck" text="随机先手"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="setupErrorLabel" visible="false" managed="false" wrapText="true"
                           styleClass="setup-error"/>
                </HBox>
            </GridPane>

            <GridPane hgap="12.0" vgap="10.0" maxHeight="236.0" styleClass="lobby-panel">
                <columnConstraints>
                    <ColumnConstraints percentWidth="38.0"/>
                    <ColumnConstraints percentWidth="62.0"/>
                </columnConstraints>
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label fx:id="roomListLabel" text="房间列表" styleClass="lobby-section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshRoomsButton" text="刷新" onAction="#onRefreshRooms"
                                mnemonicParsing="false" styleClass="btn-secondary"/>
                    </HBox>
                    <ListView fx:id="roomListView" prefHeight="132.0" styleClass="room-list-view"/>
                    <GridPane hgap="8.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="52.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label fx:id="nicknameLabel" text="昵称" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="setup-label"/>
                        <TextField fx:id="nicknameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button fx:id="createRoomButton" text="创建房间" onAction="#onCreateRoom" mnemonicParsing="false"
                                maxWidth="Infinity" GridPane.columnIndex="0" GridPane.columnSpan="2"
                                GridPane.rowIndex="1" styleClass="btn-start-room"/>
                        <Button fx:id="joinRoomButton" text="加入选中房间" onAction="#onJoinRoom" mnemonicParsing="false"
                                maxWidth="Infinity" GridPane.columnIndex="0" GridPane.columnSpan="2"
                                GridPane.rowIndex="2" styleClass="btn-secondary"/>
                    </GridPane>
                </VBox>

                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label fx:id="waitingRoomLabel" text="等待厅" styleClass="lobby-section-title"/>
                        <Label fx:id="roomStatusLabel" text="未进入房间" styleClass="connection-status"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="startRoomButton" text="开始房间" onAction="#onStartRoom" mnemonicParsing="false"
                                styleClass="btn-start-room"/>
                        <Button fx:id="leaveRoomButton" text="离开" onAction="#onLeaveRoom" mnemonicParsing="false"
                                styleClass="btn-quiet"/>
                    </HBox>
                    <FlowPane fx:id="roomMembersPane" hgap="6.0" vgap="6.0"/>
                    <GridPane fx:id="roomSeatsGrid" hgap="8.0" vgap="8.0"/>
                </VBox>
            </GridPane>

            <TextArea fx:id="trafficArea" editable="false" wrapText="true" prefRowCount="5"
                      visible="false" managed="false"
                      styleClass="traffic-area"/>
        </VBox>
    </ScrollPane>
</StackPane>
