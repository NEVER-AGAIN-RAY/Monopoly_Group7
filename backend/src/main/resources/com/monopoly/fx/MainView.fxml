<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<TabPane fx:id="rootTabPane" styleClass="root-tabs" tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.monopoly.fx.MainController">

    <Tab fx:id="gameTab" text="对局">
        <StackPane styleClass="game-screen">
            <BorderPane styleClass="game-shell">
                <top>
                    <VBox spacing="6.0" styleClass="hud-wrap">
                        <HBox fx:id="gameStatusBar" spacing="12.0" alignment="CENTER_LEFT"
                              visible="false" managed="false" styleClass="game-hud">
                            <VBox spacing="1.0">
                                <Label text="MONOPOLY DEAL" styleClass="hud-title"/>
                                <Label text="Live Table" styleClass="hud-subtitle"/>
                            </VBox>
                            <Label fx:id="summaryLabel" wrapText="true" HBox.hgrow="ALWAYS"
                                   styleClass="hud-summary"/>
                            <Button fx:id="disconnectButton" disable="true" mnemonicParsing="false"
                                    onAction="#onDisconnect" text="断开" styleClass="btn-disconnect"/>
                        </HBox>
                        <Label fx:id="errorLabelInGame" wrapText="true" visible="false" managed="false"
                               styleClass="table-error"/>
                    </VBox>
                </top>

                <center>
                    <VBox spacing="12.0" styleClass="table-layout">
                        <StackPane styleClass="felt-table" VBox.vgrow="ALWAYS">
                            <VBox spacing="12.0" alignment="TOP_CENTER">
                                <Label fx:id="boardsTitle" text="玩家桌面" visible="false" managed="false"
                                       styleClass="section-title"/>
                                <ScrollPane fx:id="boardsScrollPane" fitToHeight="true" fitToWidth="false"
                                            hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                            visible="false" managed="false" styleClass="boards-scroll"
                                            prefHeight="300.0" maxHeight="330.0">
                                    <HBox fx:id="playerBoardContainer" spacing="14.0" styleClass="player-board-row">
                                        <padding>
                                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                                        </padding>
                                    </HBox>
                                </ScrollPane>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox spacing="18.0" alignment="CENTER" styleClass="center-table-row">
                                    <VBox alignment="CENTER" spacing="8.0" styleClass="deck-pile">
                                        <StackPane styleClass="deck-card-back">
                                            <Label text="DRAW" styleClass="deck-card-text"/>
                                        </StackPane>
                                        <Label text="抽牌堆" styleClass="deck-label"/>
                                    </VBox>

                                    <VBox fx:id="actionGuidePanel" spacing="6.0" alignment="CENTER"
                                          styleClass="action-guide">
                                        <Label fx:id="actionGuideTitle" styleClass="action-guide-title"
                                               text="欢迎来到 Monopoly Deal"/>
                                        <Label fx:id="actionGuideStep1" styleClass="action-guide-step"
                                               text="选择模式，点击开始游戏。"/>
                                    </VBox>

                                    <VBox alignment="CENTER" spacing="8.0" styleClass="deck-pile">
                                        <StackPane styleClass="discard-card-face">
                                            <Label text="DISCARD" styleClass="discard-card-text"/>
                                        </StackPane>
                                        <Label text="弃牌堆" styleClass="deck-label"/>
                                    </VBox>
                                </HBox>

                                <VBox fx:id="responseBox" spacing="8.0" visible="false" managed="false"
                                      styleClass="response-panel">
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label fx:id="responseTitleLabel" wrapText="true"
                                               styleClass="response-title" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="responseCountdownLabel" styleClass="response-countdown"/>
                                    </HBox>
                                    <Label fx:id="responseContextLabel" wrapText="true"
                                           styleClass="response-context"/>
                                    <HBox spacing="10.0" alignment="CENTER">
                                        <Button fx:id="responseJsnButton" mnemonicParsing="false"
                                                onAction="#onPlayJustSayNo" text="打出 Just Say No"
                                                styleClass="btn-jsn"/>
                                        <Button fx:id="responsePassButton" mnemonicParsing="false"
                                                onAction="#onResponsePass" text="放弃响应"
                                                styleClass="btn-quiet"/>
                                    </HBox>
                                </VBox>

                                <VBox fx:id="rentPaymentBox" spacing="8.0" visible="false" managed="false"
                                      styleClass="rent-payment-panel">
                                    <Label fx:id="rentPaymentHint" wrapText="true" styleClass="rent-title"/>
                                    <Label fx:id="rentPaymentSumLabel" wrapText="true" styleClass="rent-sum"/>
                                    <FlowPane fx:id="rentPaymentPickPane" hgap="8.0" vgap="8.0"/>
                                    <HBox spacing="10.0" alignment="CENTER">
                                        <Button fx:id="rentPaymentGreedyButton" mnemonicParsing="false"
                                                onAction="#onRentPaymentGreedy" text="自动选牌"
                                                styleClass="btn-auto"/>
                                        <Button fx:id="rentPaymentSubmitButton" mnemonicParsing="false"
                                                onAction="#onRentPaymentSubmit" text="确认支付"
                                                styleClass="btn-confirm"/>
                                        <Button fx:id="rentPaymentClearButton" mnemonicParsing="false"
                                                onAction="#onRentPaymentClear" text="清空"
                                                styleClass="btn-quiet"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </StackPane>

                        <VBox spacing="8.0" styleClass="hand-dock">
                            <HBox fx:id="handHeader" alignment="CENTER_LEFT" spacing="10.0"
                                  visible="false" managed="false">
                                <Label fx:id="myHandLabel" text="我的手牌" styleClass="section-title"/>
                                <Label fx:id="selectedCardLabel" text="点选一张牌后，用下方按钮出牌"
                                       styleClass="selected-card-label"/>
                            </HBox>
                            <ScrollPane fx:id="handScroll" fitToWidth="true" hbarPolicy="AS_NEEDED"
                                        vbarPolicy="NEVER" prefHeight="228.0"
                                        visible="false" managed="false" styleClass="hand-scroll">
                                <HBox fx:id="handStrip" spacing="12.0" alignment="BOTTOM_CENTER">
                                    <padding>
                                        <Insets bottom="18.0" left="18.0" right="18.0" top="14.0"/>
                                    </padding>
                                </HBox>
                            </ScrollPane>
                        </VBox>
                    </VBox>
                </center>

                <bottom>
                    <VBox fx:id="actionBar" spacing="10.0" visible="false" managed="false"
                          styleClass="action-bar">
                        <HBox spacing="10.0" alignment="CENTER">
                            <Button fx:id="drawButton" mnemonicParsing="false" onAction="#onDraw"
                                    text="摸 2 张牌" styleClass="btn-draw"/>
                            <Button fx:id="endTurnButton" mnemonicParsing="false" onAction="#onEndTurn"
                                    text="结束回合" styleClass="btn-end-turn"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="playHintLabel" text="出牌（先点选手牌）" styleClass="action-hint"/>
                            <Button fx:id="wizardDepositButton" mnemonicParsing="false"
                                    onAction="#onWizardDeposit" text="存入银行" styleClass="btn-deposit"/>
                            <Button fx:id="wizardDeployButton" mnemonicParsing="false"
                                    onAction="#onWizardDeploy" text="部署房产" styleClass="btn-deploy"/>
                            <Button fx:id="wizardActionButton" mnemonicParsing="false"
                                    onAction="#onWizardAction" text="打出行动牌" styleClass="btn-action"/>
                            <Button fx:id="wizardDiscardButton" mnemonicParsing="false"
                                    onAction="#onWizardDiscard" text="弃牌" styleClass="btn-discard"/>
                        </HBox>
                    </VBox>
                </bottom>
            </BorderPane>

            <VBox fx:id="quickStartCard" spacing="16.0" alignment="CENTER" styleClass="quick-start-card"
                  maxWidth="760.0">
                <Label fx:id="appTitleLabel" text="Monopoly Deal" styleClass="quick-start-title"/>
                <Label fx:id="appSubtitleLabel" text="选择模式，点击开始即可游玩"
                       styleClass="quick-start-subtitle"/>

                <HBox spacing="14.0" alignment="CENTER" styleClass="setup-row">
                    <VBox spacing="5.0" alignment="CENTER_LEFT">
                        <Label fx:id="gameModeLabel" text="游戏模式" styleClass="setup-label"/>
                        <ComboBox fx:id="gameModeCombo" prefWidth="150.0"/>
                    </VBox>
                    <VBox spacing="5.0" alignment="CENTER_LEFT">
                        <Label fx:id="playerCountLabel" text="玩家人数" styleClass="setup-label"/>
                        <Spinner fx:id="playerCountSpinner" editable="false" prefWidth="105.0"/>
                    </VBox>
                    <VBox fx:id="aiDifficultyBox" spacing="5.0" alignment="CENTER_LEFT">
                        <Label fx:id="aiDifficultyLabel" text="AI 难度" styleClass="setup-label"/>
                        <ComboBox fx:id="aiDifficultyCombo" prefWidth="130.0"/>
                    </VBox>
                    <VBox spacing="5.0" alignment="CENTER_LEFT">
                        <Label fx:id="languageLabel" text="语言" styleClass="setup-label"/>
                        <ComboBox fx:id="languageCombo" prefWidth="120.0"/>
                    </VBox>
                </HBox>

                <HBox fx:id="customLineupBox" spacing="8.0" alignment="CENTER"
                      visible="false" managed="false">
                    <Label fx:id="customLineupLabel" text="自定义席位" styleClass="setup-label"/>
                    <ComboBox fx:id="customLineupCombo" prefWidth="260.0"/>
                </HBox>

                <Label fx:id="modeHintLabel" wrapText="true" styleClass="setup-hint"/>
                <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#onQuickAuthAndStart"
                        text="开始游戏" styleClass="btn-start-game"/>
                <Button fx:id="showGuideButton" mnemonicParsing="false" onAction="#onShowGuide"
                        text="如何多人联机？点此查看说明" styleClass="btn-guide-link"/>
                <Label fx:id="errorLabel" wrapText="true" visible="false" managed="false"
                       styleClass="setup-error"/>

                <TitledPane fx:id="lobbyPane" text="房间大厅" collapsible="true" expanded="false"
                            styleClass="lobby-pane">
                    <VBox spacing="10.0" styleClass="lobby-content">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label fx:id="nicknameLabel" text="昵称" styleClass="setup-label"/>
                            <TextField fx:id="nicknameField" prefWidth="150.0"/>
                            <Button fx:id="createRoomButton" mnemonicParsing="false" onAction="#onCreateRoom"
                                    text="创建房间" styleClass="btn-start-room"/>
                            <Button fx:id="joinRoomButton" mnemonicParsing="false" onAction="#onJoinRoom"
                                    text="加入房间" styleClass="btn-secondary"/>
                            <Button fx:id="refreshRoomsButton" mnemonicParsing="false" onAction="#onRefreshRooms"
                                    text="刷新房间" styleClass="btn-secondary"/>
                        </HBox>

                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="42.0"/>
                                <ColumnConstraints percentWidth="58.0"/>
                            </columnConstraints>
                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label fx:id="roomListLabel" text="房间列表" styleClass="lobby-section-title"/>
                                <ListView fx:id="roomListView" prefHeight="122.0" styleClass="room-list-view"/>
                            </VBox>
                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <Label fx:id="waitingRoomLabel" text="等待厅" styleClass="lobby-section-title"/>
                                    <Label fx:id="roomStatusLabel" text="未进入房间" styleClass="connection-status"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="startRoomButton" mnemonicParsing="false" onAction="#onStartRoom"
                                            text="开始房间" styleClass="btn-start-room"/>
                                    <Button fx:id="leaveRoomButton" mnemonicParsing="false" onAction="#onLeaveRoom"
                                            text="离开" styleClass="btn-quiet"/>
                                </HBox>
                                <FlowPane fx:id="roomMembersPane" hgap="6.0" vgap="6.0"/>
                                <GridPane fx:id="roomSeatsGrid" hgap="8.0" vgap="8.0"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <TitledPane fx:id="advancedPane" text="高级设置（服务器地址、玩家ID 等）"
                            collapsible="true" expanded="false" styleClass="advanced-pane">
                    <VBox spacing="8.0" styleClass="advanced-content">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label fx:id="serverLabel" text="服务器" styleClass="setup-label" prefWidth="56.0"/>
                            <TextField fx:id="wsUrlField" prefWidth="320.0" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="connectButton" mnemonicParsing="false" onAction="#onConnect"
                                    text="连接" styleClass="btn-secondary"/>
                            <Label fx:id="statusLabel" text="未连接" styleClass="connection-status"/>
                        </HBox>
                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="58.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0"/>
                                <ColumnConstraints hgrow="NEVER" minWidth="58.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0"/>
                            </columnConstraints>
                            <Label fx:id="playerIdLabel" text="玩家 ID" GridPane.columnIndex="0"
                                   GridPane.rowIndex="0" styleClass="setup-label"/>
                            <TextField fx:id="playerIdField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label fx:id="sessionIdLabel" text="会话 ID" GridPane.columnIndex="2"
                                   GridPane.rowIndex="0" styleClass="setup-label"/>
                            <TextField fx:id="sessionIdField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        </GridPane>
                        <CheckBox fx:id="randomizeFirstCheck" mnemonicParsing="false" text="随机先手"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Button fx:id="authOnlyButton" mnemonicParsing="false" onAction="#onAuth"
                                    text="仅认证" styleClass="btn-secondary"/>
                            <Button fx:id="startOnlyButton" mnemonicParsing="false" onAction="#onStartSession"
                                    text="仅开局" styleClass="btn-secondary"/>
                            <Button mnemonicParsing="false" onAction="#onPing" text="PING"
                                    styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                </TitledPane>
            </VBox>
        </StackPane>
    </Tab>

    <Tab fx:id="rulesTab" text="游戏规则">
        <BorderPane styleClass="info-page">
            <center>
                <WebView fx:id="rulesWebView" prefHeight="600.0"/>
            </center>
        </BorderPane>
    </Tab>

    <Tab fx:id="guideTab" text="联机指南">
        <BorderPane styleClass="info-page">
            <center>
                <WebView fx:id="guideWebView" prefHeight="600.0"/>
            </center>
        </BorderPane>
    </Tab>

    <Tab fx:id="debugTab" text="调试日志">
        <BorderPane styleClass="debug-page">
            <top>
                <VBox spacing="8.0" styleClass="debug-top">
                    <HBox spacing="8.0">
                        <Button fx:id="clearLogButton" mnemonicParsing="false" onAction="#onClearTraffic"
                                text="清空日志" styleClass="btn-secondary"/>
                    </HBox>
                    <Accordion>
                        <panes>
                            <TitledPane fx:id="debugTitledPane" animated="false" expanded="false"
                                        text="调试：手动填写参数（可选）">
                                <GridPane hgap="8.0" vgap="6.0" styleClass="debug-grid">
                                    <padding>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="6.0"/>
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="NEVER"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0"/>
                                        <ColumnConstraints hgrow="NEVER"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0"/>
                                    </columnConstraints>
                                    <Label fx:id="debugActionLabel" text="动作" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <ComboBox fx:id="playActionCombo" prefWidth="140.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <HBox spacing="8.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="0">
                                        <Button fx:id="wizardPlayButton" mnemonicParsing="false" onAction="#onPlay"
                                                text="向导：先拉选项再出牌" styleClass="btn-secondary"/>
                                        <Button fx:id="directPlayButton" mnemonicParsing="false" onAction="#onPlayDirect"
                                                text="跳过选项直接 PLAY" styleClass="btn-secondary"/>
                                    </HBox>
                                    <Label text="cardId" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="playCardIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="targetPlayer" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                    <TextField fx:id="targetPlayerField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                    <Label text="targetColor" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <TextField fx:id="targetColorField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                    <Label text="targetCard" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                    <TextField fx:id="targetCardField" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                    <Label text="actorCard" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                    <TextField fx:id="actorCardField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                    <Label text="targetZone" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                    <TextField fx:id="targetZoneField" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                                    <Label text="actingPlayer" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                    <TextField fx:id="actingPlayerField" GridPane.columnIndex="1"
                                               GridPane.columnSpan="3" GridPane.rowIndex="4"/>
                                </GridPane>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </top>
            <center>
                <AnchorPane>
                    <TextArea fx:id="trafficArea" wrapText="true" styleClass="traffic-area"
                              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                </AnchorPane>
            </center>
        </BorderPane>
    </Tab>
</TabPane>
